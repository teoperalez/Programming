# Ignore everything by default — this is a meta-repo. Each sibling project
# folder has its own git repo and must NOT be tracked here.
*

# Re-include only the meta-repo's own files
!.gitignore
!README.md
!AGENTS.md
!GTPUSH.md
!PUBLIC_RELEASE.md
!TODO.md
!repos.json
!bootstrap.ps1
!bootstrap.sh
!claude-offline.bat
!claude-offline-gui.ps1
!litellm-config.yaml

# Project scaffold seeded by the remote-execution branch
# claude/ai-band-composer-frshZ. Will be extracted into its own repo
# at github.com/teoperalez/ai-band-composer once pulled to Windows;
# this whitelist should be removed at that point.
!ai-band-composer/
!ai-band-composer/**

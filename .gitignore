# Ignore everything by default — this is a meta-repo. Each sibling project
# folder has its own git repo and must NOT be tracked here.
*

# Re-include only the meta-repo's own files
!.gitignore
!README.md
!AGENTS.md
!GTPUSH.md
!PUBLIC_RELEASE.md
!TODO.md
!repos.json
!PORTFOLIO_IDEAS.md
!bootstrap.ps1
!bootstrap.sh
!claude-offline.bat
!claude-offline-gui.ps1
!litellm-config.yaml

# Portfolio site (4 self-contained HTML versions) lives in this meta-repo.
!portfolio/
!portfolio/**

# GitHub Pages deploy workflow for the portfolio site.
!.github/
!.github/**
